# Local demonstration credentials only; use separate credentials outside this machine.
DATABASE_URL=postgresql://order_supervisor:local_demo_only@127.0.0.1:54329/order_supervisor
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=order-supervisor
ALLOWED_UI_ORIGIN=http://localhost:3000
# AGENT_MODE=live asks a real model to decide; AGENT_MODE=scripted answers from a
# deterministic stand-in, which is useful for exercising the lifecycle offline and is
# labelled as scripted wherever it appears. Live mode needs a provider, a model, and at
# least one key.
AGENT_MODE=live
# groq or google.
MODEL_PROVIDER=
# For example openai/gpt-oss-120b on groq, or gemini-3.5-flash on google.
MODEL_NAME=
MODEL_API_KEY=
# Optional. Several keys for one provider are tried in order when a request is refused
# for quota, which keeps a demonstration going without hiding the refusal. Numbered
# suffixes are discovered automatically:
# GROQ_API_KEY_1=...
# GOOGLE_API_KEY_1=...
DEMO_MODE=false
