{
  "name": "order-supervisor-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "next dev --webpack --hostname localhost --port 3000",
    "build": "next build --webpack",
    "check:contracts": "node scripts/check-contracts.mjs",
    "check:display": "node scripts/check-display.mjs",
    "start": "next start --hostname localhost --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.39.0",
    "next": "16.3.4",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
